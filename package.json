{
  "name": "profile-ai",
  "version": "1.0.0",
  "description": "Profile AI backend — Express.js, TypeScript, Prisma, Gemini",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:studio": "prisma studio --browser none",
    "docker:prisma:push": "docker compose exec app npx prisma db push",
    "docker:prisma:migrate:dev": "docker compose exec app npx prisma migrate dev",
    "docker:dev": "docker compose up --build",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:proxy": "docker compose -f docker-compose.prod.yml --profile proxy up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --profile proxy down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=200"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "prisma": "^6.16.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
