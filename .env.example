# Local development defaults. docker-compose.prod.yml forces NODE_ENV=production.
NODE_ENV=development
PORT=3000
APP_BIND=0.0.0.0
NGINX_HTTP_PORT=80
TZ=Europe/Istanbul

# Docker Compose service hostname must be `db`.
# If the password has special characters, URL-encode them
# (for example ! -> %21, * -> %2A, @ -> %40).
DATABASE_URL=postgresql://profile_ai:CHANGE_ME_STRONG_PASSWORD@db:5432/profile_ai?schema=public

POSTGRES_USER=profile_ai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=profile_ai

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://buraksafak.online,https://www.buraksafak.online,http://194.163.157.37
API_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
LOG_LEVEL=info

# Chat contact flow. Resend free tier is enough for a personal site.
# Without RESEND_API_KEY, messages are still saved in the database.
RESEND_API_KEY=
CONTACT_TO_EMAIL=buraksafak2109@gmail.com
CONTACT_FROM_EMAIL=Profile AI <beth.t@example.com>
